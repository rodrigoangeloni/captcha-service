# Secreto maestro: cámbialo por una cadena larga y aleatoria.
# Con este secreto se cifran los tokens (AES-256-GCM).
# Obligatorio en producción (NODE_ENV=production): sin él, el servicio no arranca.
CAPTCHA_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Sitios permitidos (separados por coma). Deja vacío para permitir cualquiera.
# Si defines lista, incluye "demo" para que la demo local y npm test funcionen.
CAPTCHA_SITES=sitio1,sitio2

# Vigencia del captcha en milisegundos (por defecto 90000 = 90 s)
CAPTCHA_TTL=90000

# Origen permitido por CORS (por defecto *). Ej: https://misitio.com
CAPTCHA_ORIGIN=*

# Puerto local (solo para `npm start`)
PORT=3000

# Máximo de intentos de verify por token (requiere Upstash; por defecto 5)
CAPTCHA_MAX_ATTEMPTS=5

# Peticiones por minuto por IP y ruta (rate limit en memoria; por defecto 30)
CAPTCHA_RPM=30

# Anti-replay (un solo uso) + límite de intentos: crea una base Redis gratis
# en https://upstash.com y copia aquí sus credenciales REST.
# Si se dejan vacías, el servicio funciona sin estado (con replay posible).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
