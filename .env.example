# Secreto maestro: cámbialo por una cadena larga y aleatoria.
# Con este secreto se cifran los tokens (AES-256-GCM).
CAPTCHA_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Sitios permitidos (separados por coma). Deja vacío para permitir cualquiera.
CAPTCHA_SITES=sitio1,sitio2

# Vigencia del captcha en milisegundos (por defecto 120000 = 2 min)
CAPTCHA_TTL=120000

# Origen permitido por CORS (por defecto *). Ej: https://misitio.com
CAPTCHA_ORIGIN=*

# Puerto local (solo para `npm start`)
PORT=3000
